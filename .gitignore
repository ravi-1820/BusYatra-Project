# Byte-compiled / optimized / DLL files
**/__pycache__/
**/*.py[cod]
**/*$py.class

# Django runtime and database files
**/*.log
**/local_settings.py
**/db.sqlite3
**/db.sqlite3-journal
**/db.sqlite3-shm
**/db.sqlite3-wal
**/staticfiles/

# Environment and sensitive credentials
**/.env
**/.env.*
!**/.env.example

# Virtual Environments
**/venv/
**/venv*/
**/env/
**/env*/
**/.venv/
**/myenv/
**/myenv*/
**/ENV/

# IDE and Editor configurations
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# OS generated files
.DS_Store
.DS_Store?
ehthumbs.db
Icon?
Thumbs.db

# Temporary exports and reports
*_report.txt
